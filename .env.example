# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Either set DATABASE_URL directly, or provide the fields below (recommended).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=rtu
DB_PASSWORD=rtu_password
DB_NAME=rtu
DB_SSLMODE=disable

# Optional override — when set, DB_HOST/DB_PORT/... are ignored.
# DATABASE_URL=postgres://rtu:rtu_password@127.0.0.1:5432/rtu?sslmode=disable

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
PORT=5020
# HOST=0.0.0.0

# ---------------------------------------------------------------------------
# AWS S3 (panel / device photos)
# ---------------------------------------------------------------------------
AWS_REGION=ap-southeast-1
S3_BUCKET=ccm-storage-dev
S3_APP_PREFIX=mwa
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
S3_SIGNED_URL_TTL=24h

# Upload body limit — must fit image uploads (default 10 MB)
HTTP_MAX_BODY_BYTES=10485760

# ---------------------------------------------------------------------------
# CORS (comma-separated; no trailing slash on origins)
# ---------------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com
# Default when unset: * (development only; blocked in production)
