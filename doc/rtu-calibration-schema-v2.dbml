// RTU Calibration Domain — Schema v2 (ล่าสุด — สำหรับ dbdiagram.io)
// PostgreSQL schema `rtu` | Migrations 000001–000005
//
// สถานะ operational_status:
//   - ไม่เก็บใน DB (ทั้ง panel และ device)
//   - API คำนวณจาก communication_status + health_status
//   - Priority รวมตู้: MONITORING > ABNORMAL > NORMAL
//
// Enum ในไฟล์นี้ = ค่าที่ระบบรองรับ (DB ใช้ varchar + CHECK, ยังไม่ใช้ PostgreSQL ENUM type)

Project rtu_calibration_v2 {
  database_type: 'PostgreSQL'
  Note: '''
    Master ตู้ RTU + อุปกรณ์ + ใบสอบเทียบ + รูปภาพตู้ (S3)
    ไม่รวม users table (อยู่ MWA auth service)

    Migration ล่าสุด: 000005_drop_panel_status
    Logic สถานะ RTU: internal/domain/panel_status.go

    PM/CM Report domain (proposed, ยังไม่ implement):
      - doc/rtu-full-schema.dbml  — ไฟล์เดียว paste เข้า dbdiagram.io ได้ตรงๆ (core + report รวมกัน)
      - doc/rtu-pm-cm-schema.dbml — เอกสารเหตุผล/ทางเลือกออกแบบ (ไม่ paste ตรงๆ — มี diff comment ไม่ใช่ DBML สมบูรณ์)
  '''
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// สถานะที่ผู้ใช้เห็น (computed — ไม่มี column ใน DB)
Enum operational_status {
  NORMAL     [note: 'ปกติ — online + healthy']
  MONITORING [note: 'ติดตาม — warning/degraded/unknown']
  ABNORMAL   [note: 'ผิดปกติ — critical/offline']
}

Enum communication_status {
  ONLINE   [note: 'เชื่อมต่อปกติ']
  OFFLINE  [note: 'ขาดการเชื่อมต่อ → tier ABNORMAL']
  DEGRADED [note: 'เชื่อมต่อไม่เต็มที่ → tier MONITORING']
  UNKNOWN  [note: 'ไม่ทราบสถานะ → tier MONITORING (default)']
}

Enum health_status {
  NORMAL   [note: 'สุขภาพปกติ']
  WARNING  [note: 'เตือน → tier MONITORING']
  CRITICAL [note: 'วิกฤต → tier ABNORMAL']
  UNKNOWN  [note: 'ไม่ทราบ → tier MONITORING (default)']
}

Enum calibration_result {
  PASS
  FAIL
  ADJUSTED
}

Enum panel_image_type {
  EXTERIOR [note: 'ภายนอกตู้']
  INTERIOR [note: 'ภายในตู้']
  DEVICE   [note: 'อุปกรณ์/มุมถ่าย — ไม่ FK panel_device']
}

// ---------------------------------------------------------------------------
// Enums — PM / CM (ดูตารางเต็มใน doc/rtu-pm-cm-schema.dbml)
// ---------------------------------------------------------------------------

Enum work_order_type {
  PM [note: 'Preventive Maintenance']
  CM [note: 'Corrective Maintenance']
}

Enum pm_schedule_type {
  THREE_MONTH [note: 'PM รอบ 3 เดือน']
  SIX_MONTH   [note: 'PM รอบ 6 เดือน — รวม calibration flow/pressure']
}

Enum work_order_status {
  ASSIGNED          [note: 'มอบหมายแล้ว']
  PENDING           [note: 'รอดำเนินการ / CM Pending']
  IN_PROGRESS       [note: 'ระหว่างดำเนินการ']
  PENDING_APPROVAL  [note: 'รออนุมัติ']
  COMPLETED         [note: 'เสร็จสิ้น']
  CONDITIONAL       [note: 'เสร็จสิ้นแบบมีเงื่อนไข']
}

Enum work_order_priority {
  HIGH   [note: 'สูง']
  MEDIUM [note: 'กลาง']
  LOW    [note: 'ต่ำ']
}

Enum work_order_party {
  SUB_CONTRACTOR [note: 'ผู้รับเหมา']
  OPERATOR       [note: 'เจ้าหน้าที่ MWA']
}

// ตาราง PM/CM: doc/rtu-pm-cm-schema.dbml (work_orders, attachments, checklist, status_logs)

// Function rtu.set_updated_at() — BEFORE UPDATE trigger บนทุกตารางที่มี updated_at

Table rtu.panels {
  id uuid [pk, default: `gen_random_uuid()`, note: 'รหัสประจำตู้ RTU']
  code varchar(20) [not null, unique, note: 'รหัสตู้ RTU (business key)']
  location text [note: 'รายละเอียดตำแหน่งติดตั้งตู้ RTU']
  latitude numeric(10,7) [note: 'ละติจูด (−90 … 90)']
  longitude numeric(10,7) [note: 'ลองจิจูด (−180 … 180)']
  active boolean [not null, default: true, note: 'สถานะการใช้งาน (soft delete = false)']

  created_at timestamptz [not null, default: `now()`, note: 'วันที่สร้างข้อมูล']
  updated_at timestamptz [not null, default: `now()`, note: 'วันที่แก้ไขข้อมูลล่าสุด']
  created_by uuid [note: 'รหัสผู้สร้างข้อมูล (MWA user id)']
  updated_by uuid [note: 'รหัสผู้แก้ไขข้อมูลล่าสุด']

  Indexes {
    code [unique, name: 'uk_panels_code']
    active [name: 'idx_panels_active']
  }

  Note: '''
    CHECK ck_panels_latitude, ck_panels_longitude
    Trigger trg_panels_updated_at

    API field (computed, ไม่มี column):
      operational_status : operational_status
      = aggregate จาก panel_devices.active ที่ map แล้ว
      Priority: MONITORING > ABNORMAL > NORMAL
  '''
}

Table rtu.device_models {
  id uuid [pk, default: `gen_random_uuid()`, note: 'รหัสรุ่นอุปกรณ์']
  code varchar(30) [not null, unique, note: 'รหัสอ้างอิงรุ่นอุปกรณ์']
  name varchar(100) [not null, note: 'ชื่อประเภทอุปกรณ์']
  manufacturer varchar(100) [note: 'ผู้ผลิตอุปกรณ์']
  model varchar(100) [note: 'ชื่อรุ่นอุปกรณ์']
  description text [note: 'รายละเอียดเพิ่มเติมของรุ่นอุปกรณ์']
  active boolean [not null, default: true, note: 'สถานะการใช้งานของรุ่นอุปกรณ์']

  created_at timestamptz [not null, default: `now()`, note: 'วันที่สร้างข้อมูล']
  updated_at timestamptz [not null, default: `now()`, note: 'วันที่แก้ไขข้อมูลล่าสุด']
  created_by uuid [note: 'รหัสผู้สร้างข้อมูล']
  updated_by uuid [note: 'รหัสผู้แก้ไขข้อมูลล่าสุด']

  Indexes {
    code [unique, name: 'uk_device_model_code']
    active [name: 'idx_device_models_active']
  }
}

Table rtu.panel_devices {
  id uuid [pk, default: `gen_random_uuid()`, note: 'รหัสอุปกรณ์ที่ติดตั้ง']
  panel_id uuid [not null, note: 'อ้างอิงตู้ RTU ที่ติดตั้ง']
  device_model_id uuid [not null, note: 'อ้างอิงรุ่นอุปกรณ์']
  tag_name varchar(100) [note: 'Tag Name หรือชื่ออุปกรณ์ภายในตู้ — unique ต่อ panel']
  serial_number varchar(100) [note: 'Serial Number ของอุปกรณ์ — unique ทั้งระบบ']
  asset_code varchar(100) [note: 'รหัสครุภัณฑ์หรือทรัพย์สิน']
  firmware_version varchar(50) [note: 'เวอร์ชัน Firmware']
  communication_status communication_status [not null, default: 'UNKNOWN', note: 'เก็บใน DB — telemetry']
  health_status health_status [not null, default: 'UNKNOWN', note: 'เก็บใน DB — telemetry']
  installed_at date [note: 'วันที่ติดตั้งอุปกรณ์']
  last_seen_at timestamptz [note: 'เวลาที่อุปกรณ์ส่งข้อมูลล่าสุด']
  note text [note: 'หมายเหตุเพิ่มเติม']
  active boolean [not null, default: true, note: 'สถานะการใช้งานของอุปกรณ์']

  created_at timestamptz [not null, default: `now()`, note: 'วันที่สร้างข้อมูล']
  updated_at timestamptz [not null, default: `now()`, note: 'วันที่แก้ไขข้อมูลล่าสุด']
  created_by uuid [note: 'รหัสผู้สร้างข้อมูล']
  updated_by uuid [note: 'รหัสผู้แก้ไขข้อมูลล่าสุด']

  Indexes {
    panel_id [name: 'idx_panel_devices_panel_id']
    device_model_id [name: 'idx_panel_devices_device_model_id']
    serial_number [unique, name: 'uk_device_serial']
    (panel_id, device_model_id) [name: 'idx_panel_devices_panel_model']
    (panel_id, tag_name) [unique, name: 'uk_panel_device_tag', note: 'partial WHERE tag_name IS NOT NULL']
    active [name: 'idx_panel_devices_active']
  }

  Note: '''
    CHECK ck_panel_devices_communication_status
    CHECK ck_panel_devices_health_status
    POST /panel-devices/{id}/status อัปเดต communication/health/last_seen_at

    API field (computed, ไม่มี column):
      operational_status : operational_status
      = map(communication_status, health_status)
      CRITICAL|OFFLINE → ABNORMAL; WARNING|DEGRADED|UNKNOWN → MONITORING; else NORMAL
  '''
}

Table rtu.calibration_instruments {
  id uuid [pk, default: `gen_random_uuid()`, note: 'รหัสเครื่องมือสอบเทียบ']
  name varchar(100) [not null, note: 'ชื่อเครื่องมือสอบเทียบ']
  manufacturer varchar(100) [note: 'ผู้ผลิตเครื่องมือ']
  model varchar(100) [note: 'รุ่นของเครื่องมือ']
  serial_number varchar(100) [unique, note: 'Serial Number ของเครื่องมือ']
  calibration_date date [note: 'วันที่สอบเทียบล่าสุด']
  expire_date date [note: 'วันที่หมดอายุการสอบเทียบ']
  active boolean [not null, default: true, note: 'สถานะการใช้งานของเครื่องมือ']

  created_at timestamptz [not null, default: `now()`, note: 'วันที่สร้างข้อมูล']
  updated_at timestamptz [not null, default: `now()`, note: 'วันที่แก้ไขข้อมูลล่าสุด']
  created_by uuid [note: 'รหัสผู้สร้างข้อมูล']
  updated_by uuid [note: 'รหัสผู้แก้ไขข้อมูลล่าสุด']

  Indexes {
    serial_number [unique, name: 'uk_instrument_serial']
    active [name: 'idx_calibration_instruments_active']
    expire_date [name: 'idx_calibration_instruments_expire_date']
  }

  Note: 'CHECK expire_date > calibration_date เมื่อทั้งคู่ไม่ null'
}

Table rtu.calibrations {
  id uuid [pk, default: `gen_random_uuid()`, note: 'รหัสรายการสอบเทียบ']
  panel_device_id uuid [not null, note: 'อ้างอิงอุปกรณ์ที่ถูกสอบเทียบ']
  instrument_id uuid [not null, note: 'อ้างอิงเครื่องมือที่ใช้สอบเทียบ']
  performed_by varchar(100) [note: 'ผู้ดำเนินการสอบเทียบ (ชื่อ/รหัส business — ไม่ใช่ created_by)']
  performed_at timestamptz [not null, note: 'วันและเวลาที่สอบเทียบ']
  result calibration_result [not null]
  remark text [note: 'หมายเหตุผลการสอบเทียบ']

  created_at timestamptz [not null, default: `now()`, note: 'วันที่สร้างข้อมูล']
  updated_at timestamptz [not null, default: `now()`, note: 'วันที่แก้ไขข้อมูลล่าสุด']
  created_by uuid [note: 'รหัสผู้สร้างข้อมูล']
  updated_by uuid [note: 'รหัสผู้แก้ไขข้อมูลล่าสุด']

  Indexes {
    panel_device_id [name: 'idx_calibrations_panel_device_id']
    instrument_id [name: 'idx_calibrations_instrument_id']
    performed_at [name: 'idx_calibrations_performed_at']
    (panel_device_id, performed_at) [name: 'idx_calibrations_device_performed_at']
  }
}

Table rtu.calibration_readings {
  id uuid [pk, default: `gen_random_uuid()`, note: 'รหัสรายการค่าที่วัดได้']
  calibration_id uuid [not null, note: 'อ้างอิงรายการสอบเทียบ']
  sequence smallint [not null, note: 'ลำดับการวัด (>= 1, unique ต่อใบ)']
  item_label varchar(150) [note: 'ชื่อหัวข้อหรือจุดที่วัด']
  parameter_key varchar(50) [not null, note: 'รหัสพารามิเตอร์ เช่น pressure, flow']
  value numeric [note: 'ค่าที่วัดได้']
  unit varchar(20) [note: 'หน่วย เช่น bar, mA']

  created_at timestamptz [not null, default: `now()`, note: 'วันที่สร้างข้อมูล']
  updated_at timestamptz [not null, default: `now()`, note: 'วันที่แก้ไขข้อมูลล่าสุด']
  created_by uuid [note: 'รหัสผู้สร้างข้อมูล']
  updated_by uuid [note: 'รหัสผู้แก้ไขข้อมูลล่าสุด']

  Indexes {
    calibration_id [name: 'idx_calibration_readings_calibration_id']
    parameter_key [name: 'idx_calibration_readings_parameter_key']
    (calibration_id, sequence) [unique, name: 'uk_calibration_reading_sequence']
  }

  Note: 'FK calibrations ON DELETE CASCADE'
}

Table rtu.panel_images {
  id uuid [pk, default: `gen_random_uuid()`, note: 'รหัสรูปภาพ']
  panel_id uuid [not null, note: 'ตู้ RTU ที่รูปนี้เกี่ยวข้อง — อ้างอิงแค่ตู้']
  image_type panel_image_type [not null]
  s3_bucket varchar(100) [not null, note: 'ชื่อ S3 Bucket']
  s3_key varchar(500) [not null, note: 'S3 Object Key']
  original_name varchar(255) [note: 'ชื่อไฟล์ต้นฉบับ']
  mime_type varchar(100) [not null, note: 'image/jpeg | image/png | image/webp | image/gif']
  file_size bigint [not null, note: 'ขนาดไฟล์ bytes — สูงสุด 10 MB']
  caption text [note: 'คำอธิบายรูป — ระบุอุปกรณ์/มุมถ่ายได้อิสระ']
  sort_order smallint [not null, default: 0, note: 'ลำดับการแสดงผล']
  active boolean [not null, default: true, note: 'สถานะการใช้งานรูปภาพ (soft delete)']

  created_at timestamptz [not null, default: `now()`, note: 'วันที่สร้างข้อมูล']
  updated_at timestamptz [not null, default: `now()`, note: 'วันที่แก้ไขข้อมูลล่าสุด']
  created_by uuid [note: 'รหัสผู้สร้างข้อมูล']
  updated_by uuid [note: 'รหัสผู้แก้ไขข้อมูลล่าสุด']

  Indexes {
    panel_id [name: 'idx_panel_images_panel_id']
    (panel_id, image_type) [name: 'idx_panel_images_panel_type']
    (panel_id, sort_order) [name: 'idx_panel_images_panel_sort']
    active [name: 'idx_panel_images_active']
  }

  Note: '''
    ไม่มี panel_device_id — ยืดหยุ่นสูงสุด
    S3 key: {prefix}/images/rtu/panels/{panel_code}/{uuid}.ext
    CHECK file_size BETWEEN 1 AND 10485760
  '''
}

// ---------------------------------------------------------------------------
// Relationships
// ---------------------------------------------------------------------------

Ref: rtu.panel_devices.panel_id > rtu.panels.id [delete: restrict, update: cascade]
Ref: rtu.panel_devices.device_model_id > rtu.device_models.id [delete: restrict, update: cascade]
Ref: rtu.calibrations.panel_device_id > rtu.panel_devices.id [delete: restrict, update: cascade]
Ref: rtu.calibrations.instrument_id > rtu.calibration_instruments.id [delete: restrict, update: cascade]
Ref: rtu.calibration_readings.calibration_id > rtu.calibrations.id [delete: cascade, update: cascade]
Ref: rtu.panel_images.panel_id > rtu.panels.id [delete: restrict, update: cascade]
