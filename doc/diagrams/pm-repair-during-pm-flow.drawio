<mxfile host="app.diagrams.net" modified="2026-09-04T00:00:00.000Z" agent="RTU API" version="22.1.0">
  <diagram id="pm-repair-flow" name="PM Repair During PM Visit">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="RTU — แจ้งซ่อมระหว่างทำ PM (Onsite Fix vs Escalate CM)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="720" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="เงื่อนไข: ต้องมี PM Work Order เปิดอยู่ + กำลังทำ PM (check-in แล้ว)" style="text;html=1;strokeColor=none;fillColor=#FFF2CC;align=center;verticalAlign=middle;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="65" width="640" height="30" as="geometry" />
        </mxCell>

        <!-- Start -->
        <mxCell id="n1" value="สร้าง PM Work Order&#xa;POST /work-orders&#xa;work_order_type = PM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="420" y="110" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="Check-in&#xa;POST .../check-in&#xa;status → IN_PROGRESS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="420" y="210" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="บันทึก PM Report (draft)&#xa;PUT .../pm-report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="420" y="310" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="เจอปัญหา&#xa;ระหว่างทำ PM?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="450" y="410" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- No problem path -->
        <mxCell id="n4" value="ทำ checklist PM ต่อ&#xa;→ Submit PM Report&#xa;→ Approval → COMPLETED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="760" y="425" width="260" height="70" as="geometry" />
        </mxCell>

        <!-- Decision fix on site -->
        <mxCell id="d2" value="ซ่อมหน้างาน&#xa;ได้ไหม?&#xa;(จบในวัน)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="450" y="550" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- Onsite fix -->
        <mxCell id="n5" value="✅ ONSITE FIX — ซ่อมได้เลย&#xa;&#xa;POST /pm-reports/{id}/onsite-fixes&#xa;&#xa;• สร้าง cm_reports (origin: PM_ONSITE_FIX)&#xa;• pm_report_id ✓  |  work_order_id ✗&#xa;• ไม่มี CM work_order_no&#xa;• ended_at = จบแล้ว (default now)&#xa;• ไม่มี workflow CM (check-in/submit/approve)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="120" y="530" width="300" height="150" as="geometry" />
        </mxCell>

        <mxCell id="n5b" value="ทำ PM ต่อได้ตามปกติ&#xa;(checklist ไม่ขาด)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="120" y="710" width="300" height="50" as="geometry" />
        </mxCell>

        <!-- Escalate -->
        <mxCell id="n6" value="❌ ESCALATE — ซ่อมไม่ได้ / ส่งต่อ&#xa;&#xa;POST /pm-reports/{id}/escalate&#xa;&#xa;• สร้าง CM Work Order ใหม่&#xa;• มี work_order_no (CM-...)&#xa;• cm_reports (origin: PM_ESCALATED)&#xa;• CM status เริ่ม PENDING&#xa;• ช่างทำ PM ต่อได้ — CM รอทีหลัง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="530" width="300" height="150" as="geometry" />
        </mxCell>

        <mxCell id="n6b" value="CM ใบงานแยก&#xa;→ assign → check-in → report → approve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="700" y="710" width="300" height="50" as="geometry" />
        </mxCell>

        <!-- Merge back -->
        <mxCell id="n7" value="Submit PM Report + Approve PM&#xa;(ใบ PM ปิดตาม workflow ปกติ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="420" y="820" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- Legend box -->
        <mxCell id="legend" value="&lt;b&gt;3 ต้นทาง cm_reports&lt;/b&gt;&#xa;&#xa;PM_ONSITE_FIX — ไม่มี work_order (ซ่อมหน้างาน)&#xa;PM_ESCALATED — มี work_order + pm_report (ส่งต่อ)&#xa;STANDALONE — มี work_order เท่านั้น (แจ้ง CM ตรง ไม่ผ่าน PM)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFCC;strokeColor=#CCCC00;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="120" y="900" width="380" height="100" as="geometry" />
        </mxCell>

        <mxCell id="api" value="&lt;b&gt;API สรุป&lt;/b&gt;&#xa;&#xa;Onsite: POST .../pm-reports/{id}/onsite-fixes&#xa;Escalate: POST .../pm-reports/{id}/escalate&#xa;List onsite: GET .../pm-reports/{id}/onsite-fixes" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFCC;strokeColor=#CCCC00;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="900" width="480" height="100" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="n2" target="n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="n3" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="ไม่เจอ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="d1" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="เจอ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="d1" target="d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="ได้" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="d2" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="ไม่ได้" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="d2" target="n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="n5" target="n5b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="n6" target="n6b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="n5b" target="n7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="n6b" target="n7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;" edge="1" parent="1" source="n4" target="n7">
