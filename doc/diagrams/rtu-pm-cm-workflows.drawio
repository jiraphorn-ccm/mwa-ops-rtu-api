        <mxCell id="c3" value="Optional: POST .../reassign&amp;#xa;(ก่อน check-in เท่านั้น · E300_208 ถ้า check-in แล้ว)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFCC;strokeColor=#CCCC00;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="POST .../check-in&amp;#xa;status → IN_PROGRESS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="180" width="360" height="50" as="geometry" />
