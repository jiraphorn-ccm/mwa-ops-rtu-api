        <mxCell id="c3" value="🔵 PM Work Order&amp;#xa;POST /work-orders&amp;#xa;work_order_type=PM&amp;#xa;+ pm_schedule_type&amp;#xa;&amp;#xa;→ lifecycle แยก (ดู tab 01)&amp;#xa;→ มี work_order_no PM-..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=8;" vertex="1" parent="1">
