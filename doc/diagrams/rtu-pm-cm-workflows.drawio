        <mxCell id="c9" value="Submit validation&amp;#xa;THREE_MONTH → ต้องมี power_test (E300_236)&amp;#xa;SIX_MONTH → calibration ≥1 ผูก PM (E300_237)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" vertex="1" parent="1">
