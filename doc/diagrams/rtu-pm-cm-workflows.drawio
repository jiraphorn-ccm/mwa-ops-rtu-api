        </mxCell>
        <mxCell id="c5" value="🟢 Onsite Fix (ไม่มี CM WO)&amp;#xa;POST /pm-reports/{id}/onsite-fixes&amp;#xa;&amp;#xa;cm_reports PM_ONSITE_FIX&amp;#xa;work_order_id = NULL&amp;#xa;จบด้วย ended_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=8;" vertex="1" parent="1">
