        <mxCell id="c5" value="PUT .../pm-report (replace aggregate · DRAFT)&amp;#xa;engineer_id · checklist_results[] · ground_test · power_test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="250" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="ระหว่างทำ PM: แจ้งซ่อม?&amp;#xa;(ดู tab 04 — onsite / escalate)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="470" y="340" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="Optional: POST .../check-out&amp;#xa;บันทึกเวลาออก · status ยัง IN_PROGRESS" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFCC;strokeColor=#CCCC00;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="350" width="300" height="50" as="geometry" />
