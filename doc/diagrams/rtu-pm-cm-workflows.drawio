        <mxCell id="c8" value="POST .../pm-report/submit · actor_id&amp;#xa;status → PENDING_APPROVAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=8;" vertex="1" parent="1">
