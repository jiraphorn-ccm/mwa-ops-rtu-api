        <mxCell id="c4" value="🔴 CM Work Order (Standalone)&amp;#xa;POST /work-orders&amp;#xa;work_order_type=CM&amp;#xa;+ problem_topic_id(s)&amp;#xa;&amp;#xa;→ duplicate check panel+topic&amp;#xa;→ lifecycle แยก (ดู tab 02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=8;" vertex="1" parent="1">
